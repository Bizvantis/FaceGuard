.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
# downloaded by setup.bat / "python -m faceguard download-models"
models/*.onnx
models/*.task

# --- not for the public repository ---------------------------------------------------------------
# Third-party datasets and models: licences forbid redistribution (LFW, MPIIFaceGaze CC BY-NC-SA,
# InsightFace non-commercial); experiments/README.md explains how to download them.
experiments/data/
# Large arrays derived from LFW faces (embeddings, 3-D face meshes); regenerated by the scripts.
experiments/results/*.npz
# Raw real-world and physical-study logs: per-frame face landmarks of participants (personal biometric data).
# The anonymous summary experiments/results/realworld.json is kept.
experiments/results/realworld/
experiments/results/physical/
# Superseded intermediate results (older protocol versions)
experiments/results/*_v[0-9]*.json
# Build tools and paper drafts
tools/
paper/faceguard_v*
paper/references_v*.bib
paper/faceguard_before*
paper/references_before*
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
# co-author photos (personal data; only for the Overleaf project)
paper/authors/
